# Transcription: Set GROQ_API_KEY for cloud whisper-large-v3, or leave empty to use local free faster-whisper
GROQ_API_KEY=
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# AI Hook Extraction: Set GEMINI_API_KEY (recommended free tier) OR OPENAI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Supabase Storage / Postgres metadata sync
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
